{
  // Solo para el editor y `npm run typecheck`: los scripts corren con
  // `node --experimental-strip-types`, sin compilar.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.mts", "scripts/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["node_modules", "scripts/out"]
}
