{
  // For the editor, `pnpm typecheck` and the Next build. The scripts run with
  // `node --experimental-strip-types`, without compiling.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/modules/**/*.ts",
    "src/modules/**/*.tsx",
    "src/shared/**/*.ts",
    "src/shared/**/*.tsx",
    "scripts/**/*.mts",
    "scripts/**/*.ts",
    "tests/**/*.mts",
    "*.config.mts",
    "*.config.ts"
  ],
  "exclude": ["node_modules", "scripts/out", ".next"]
}
