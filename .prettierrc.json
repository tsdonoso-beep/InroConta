{
  "printWidth": 160,
  "tabWidth": 4,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "auto",
  "overrides": [
    {
      "files": "*.gs",
      "options": {
        "parser": "babel"
      }
    },
    {
      "files": ["*.json", "*.md", "*.yml", "*.yaml", "*.mjs", "*.cjs"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
